<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.weep.mapper.CategoriesMapper">

    <resultMap id="BaseResultMap" type="com.weep.entity.Categories">
        <id column="id" property="id" />
        <result column="category_name" property="category_name" />
        <result column="parent_id" property="parent_id" />
        <result column="description" property="description" />
        <result column="sort_order" property="sort_order" />
    </resultMap>

    <sql id="BaseColumnList">
        id, category_name, parent_id, description, sort_order
    </sql>

    <select id="findById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumnList" />
        FROM categories
        WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumnList" />
        FROM categories
        ORDER BY sort_order ASC, id ASC
    </select>

    <select id="findParentCategories" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumnList" />
        FROM categories
        WHERE parent_id = 0
        ORDER BY sort_order ASC, id ASC
    </select>

    <select id="findByParentId" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumnList" />
        FROM categories
        WHERE parent_id = #{parent_id}
        ORDER BY sort_order ASC, id ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO categories (
            category_name, parent_id, description, sort_order
        ) VALUES (
            #{category_name}, #{parent_id}, #{description}, #{sort_order}
        )
    </insert>

    <update id="update">
        UPDATE categories SET
            category_name = #{category_name},
            parent_id = #{parent_id},
            description = #{description},
            sort_order = #{sort_order}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM categories WHERE id = #{id}
    </delete>

    <select id="countByParentId" resultType="int">
        SELECT COUNT(*) FROM categories WHERE parent_id = #{parent_id}
    </select>

</mapper>
