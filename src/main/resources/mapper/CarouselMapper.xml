<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.weep.mapper.CarouselMapper">

    <resultMap id="CarouselResult" type="com.weep.entity.Carousel">
        <id property="id" column="id"/>
        <result property="imageUrl" column="image_url"/>
        <result property="title" column="title"/>
        <result property="linkUrl" column="link_url"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findActive" resultMap="CarouselResult">
        SELECT * FROM carousels WHERE status = 1 ORDER BY sort_order ASC
    </select>

    <select id="findAll" resultMap="CarouselResult">
        SELECT * FROM carousels ORDER BY sort_order ASC
    </select>

    <select id="findById" resultMap="CarouselResult">
        SELECT * FROM carousels WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.weep.entity.Carousel" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO carousels (image_url, title, link_url, sort_order, status)
        VALUES (#{imageUrl}, #{title}, #{linkUrl}, #{sortOrder}, #{status})
    </insert>

    <update id="update" parameterType="com.weep.entity.Carousel">
        UPDATE carousels
        SET image_url = #{imageUrl}, title = #{title}, link_url = #{linkUrl},
            sort_order = #{sortOrder}, status = #{status}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM carousels WHERE id = #{id}
    </delete>

    <update id="updateStatus">
        UPDATE carousels SET status = #{status} WHERE id = #{id}
    </update>

</mapper>
